# ASI:One key (https://asi1.ai -> Developer -> API keys). Without it LORE runs in offline mode.
ASI1_API_KEY=
ASI1_MODEL=asi1

# Unique secret seed for your agents' identities. If unset, one is generated in data/.agent_seed.
LORE_SEED=

# 1 = connect the public "lore" agent to Agentverse via mailbox (needed for ASI:One)
LORE_MAILBOX=1
LORE_PORT=8000
# Optional Agentverse handle for the public agent
LORE_HANDLE=

# Optional: event-driven mode, poll a GitHub repo for newly merged PRs
LORE_WATCH_REPO=
LORE_WATCH_SECONDS=900
GITHUB_TOKEN=

# ASI:One key (https://asi1.ai -> Developer -> API keys). Without it LORE runs in offline mode.
ASI1_API_KEY=
ASI1_MODEL=asi1

# Unique secret seed for your agents' identities. If unset, one is generated in data/.agent_seed.
LORE_SEED=

# Agentverse API key (agentverse.ai -> profile -> API Keys). Only needed for
# scripts/connect_mailbox.py, if the browser inspector can't reach your agent.
AGENTVERSE_API_KEY=

# 1 = connect the public "lore" agent to Agentverse via mailbox (needed for ASI:One)
LORE_MAILBOX=1
LORE_PORT=8000
# Optional Agentverse handle for the public agent
LORE_HANDLE=
# Name and profile picture shown on Agentverse and ASI:One (the address never changes)
LORE_DISPLAY_NAME=lore
LORE_AVATAR_URL=https://raw.githubusercontent.com/Kasimshaik2508/LORE/main/assets/avatar.png

# Optional: event-driven mode, poll a GitHub repo for newly merged PRs
LORE_WATCH_REPO=
LORE_WATCH_SECONDS=900
GITHUB_TOKEN=
